BOT_TOKEN=token
# Port of the server the glasses connect to
WS_PORT=8080
# Seconds of silence before a burst becomes one card
BATCH_SILENCE_SEC=10
# SQLite file, relative to the repo root
DB_PATH=data/vyrse.db

# Secretary agent (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
