{
  "name": "vyrse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "pnpm --filter @vyrse/server dev:legacy-server",
    "dev:bot": "pnpm --filter @vyrse/server dev:legacy-bot",
    "dev:next": "pnpm --filter @vyrse/server dev",
    "dev:glasses": "pnpm --filter @vyrse/glasses dev",
    "build:glasses": "pnpm --filter @vyrse/glasses build",
    "sim": "pnpm --filter @vyrse/glasses sim",
    "qr": "pnpm --filter @vyrse/glasses qr",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.18.0"
}
