{
  "name": "hu-hackathon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/server.ts",
    "dev:bot": "tsx watch bot/bot.ts",
    "start:server": "node --enable-source-maps dist/server.js",
    "start:bot": "node --enable-source-maps dist/bot.js",
    "build": "pnpm typecheck && pnpm build:server && pnpm build:bot && pnpm build:glasses",
    "typecheck": "tsc --noEmit",
    "build:server": "esbuild server/server.ts --bundle --platform=node --target=node22 --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "build:bot": "esbuild bot/bot.ts --bundle --platform=node --target=node22 --format=esm --packages=external --sourcemap --outfile=dist/bot.js",
    "dev:glasses": "vite --config app/vite.config.ts",
    "build:glasses": "vite build --config app/vite.config.ts",
    "sim": "evenhub-simulator http://localhost:5173",
    "qr": "evenhub qr --port 5173"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "dotenv": "^18.0.10",
    "grammy": "^1.46.0",
    "openai": "^7.62.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "packageManager": "pnpm@12.18.0"
}
