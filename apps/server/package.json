{
  "name": "@vyrse/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "dev:legacy-server": "cd ../.. && tsx watch apps/server/legacy/server/server.ts",
    "dev:legacy-bot": "cd ../.. && tsx watch apps/server/legacy/bot/bot.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p legacy",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@vyrse/protocol": "workspace:*",
    "dotenv": "^18.0.10",
    "grammy": "^1.48.0",
    "openai": "^7.65.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.2"
  }
}
